# =========================================================
#  Clothing Rental System — Environment configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าให้ครบ
# =========================================================

# ---------- App ----------
NODE_ENV=development
PORT=3000
# URL สาธารณะของเว็บไซต์ (ใช้สร้าง Callback URL ของ LINE และลิงก์ในข้อความแจ้งเตือน)
BASE_URL=http://localhost:3000
# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- LINE Login (LINE Developers > LINE Login channel) ----------
# Callback URL ที่ต้องลงทะเบียนใน LINE Console:  {BASE_URL}/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ---------- LINE OA / Messaging API (LINE Developers > Messaging API channel) ----------
# สำคัญ: LINE Login channel และ Messaging API channel ต้องอยู่ภายใต้ Provider เดียวกัน
# ไม่เช่นนั้น userId ที่ได้จากการ Login จะไม่ตรงกับ userId ของ OA และส่งข้อความไม่ได้
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Basic ID ของ OA (เช่น @abc1234) ใช้แสดงปุ่ม "เพิ่มเพื่อน"
LINE_OA_BASIC_ID=

# ---------- Admin ----------
# LINE userId (ขึ้นต้นด้วย U...) ของผู้ที่เป็น Admin คั่นด้วย comma
# ดู userId ของตัวเองได้ที่หน้า /account หลัง Login หรือใน LINE Developers Console (Your user ID)
ADMIN_LINE_USER_IDS=

# ---------- Google Sheets (Service Account) ----------
# 1) สร้าง Service Account ใน Google Cloud และเปิดใช้ Google Sheets API
# 2) แชร์ Spreadsheet ให้อีเมลของ Service Account เป็น Editor
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Orders
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ใส่ private key ทั้งก้อน โดยแทนการขึ้นบรรทัดใหม่ด้วย \n และครอบด้วยเครื่องหมายคำพูด
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# หรือระบุ path ไปยังไฟล์ JSON ของ Service Account แทน 2 ค่าบน
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ---------- Development only ----------
# เปิดปุ่ม "Dev Login" สำหรับทดสอบระบบก่อนตั้งค่า LINE (ไม่ใช่ LINE Login จริง)
# ระบบจะปิดอัตโนมัติเมื่อ NODE_ENV=production
DEV_LOGIN_ENABLED=true

# ---------- Storage ----------
DATA_DIR=./data
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_KEEP=14

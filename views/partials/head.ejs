<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const pageTitle = (typeof title !== 'undefined' && title ? title + ' · ' : '') + settings.shop_name; %>
  <title><%= pageTitle %></title>
  <meta name="theme-color" content="#0e0c0b">
  <meta name="description" content="<%= settings.share_description %>">
  <%# link preview (LINE / Facebook / X): logo + shop name + description %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= settings.shop_name %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' && title && typeof p !== 'undefined' && p && p.name ? pageTitle : settings.shop_name) %>">
  <meta property="og:description" content="<%= settings.share_description %>">
  <meta property="og:url" content="<%= config.baseUrl %><%= typeof path !== 'undefined' ? path : '/' %>">
  <meta property="og:image" content="<%= config.baseUrl %>/static/img/brand/og.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= settings.shop_name %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Noto+Sans+Thai:wght@300;400;500;600&family=Noto+Serif+Thai:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/static/img/brand/favicon-64.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/static/img/brand/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <script src="/static/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body>

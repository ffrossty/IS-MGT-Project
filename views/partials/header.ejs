<%- include('head') %>
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand"><span class="name"><%= settings.shop_name %></span><span class="tag"><%= settings.shop_tagline %></span></a>
    <button class="menu-toggle" data-toggle=".nav" aria-label="เมนู">☰</button>
    <nav class="nav">
      <a href="/">คอลเลกชัน</a>
      <% if (user) { %>
        <a href="/orders">คำสั่งจองของฉัน</a>
        <a href="/cart">ตะกร้า<span class="cart-count"><%= cartCount %></span></a>
        <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
        <a href="/account" class="row" style="gap:8px">
          <% if (user.picture_url) { %><img class="avatar" src="<%= user.picture_url %>" alt=""><% } else { %><span class="avatar"><%= (user.display_name||'?').slice(0,1) %></span><% } %>
          <span><%= user.display_name %></span>
        </a>
      <% } else { %>
        <a href="/login" class="btn line sm" style="color:#fff">เข้าสู่ระบบด้วย LINE</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash) { %><div class="container"><div class="flash <%= flash.type %>"><%= flash.msg %></div></div><% } %>

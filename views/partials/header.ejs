<%- include('head') %>
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand brand-logo" aria-label="<%= settings.shop_name %> — หน้าแรก"><img src="/static/img/brand/logo-champagne.png?v=<%= assetVersion %>" alt="<%= settings.shop_name %>" width="130" height="45"></a>
    <% if (user) { %><a href="/cart" class="cart-mini" aria-label="ตะกร้า"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg><% if (cartCount) { %><span class="cart-count"><%= cartCount %></span><% } %></a><% } %>
    <button class="menu-toggle" data-toggle=".nav" aria-label="เมนู"><span></span><span></span><span></span></button>
    <nav class="nav">
      <a href="/">คอลเลกชัน</a>
      <% if (user) { %>
        <a href="/orders">คำสั่งจองของฉัน</a>
        <a href="/cart">ตะกร้า<span class="cart-count"><%= cartCount %></span></a>
        <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
        <a href="/account" class="row" style="gap:8px">
          <% if (user.picture_url) { %><img class="avatar" src="<%= user.picture_url %>" alt=""><% } else { %><span class="avatar"><%= (user.display_name||'?').slice(0,1) %></span><% } %>
          <span><%= user.display_name %></span>
        </a>
      <% } else { %>
        <a href="/login" class="btn line sm" style="color:#fff">เข้าสู่ระบบด้วย LINE</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash) { %><div class="container"><div class="flash <%= flash.type %>"><%= flash.msg %></div></div><% } %>

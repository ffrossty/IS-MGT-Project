<%- include('head') %>
<div class="admin">
  <aside class="sidebar" id="sidebar">
    <a href="/admin" class="brand"><span class="name"><%= settings.shop_name %></span><span class="tag">Admin Dashboard</span></a>
    <nav>
      <% const nav = [
        ['sec','ภาพรวม'], ['/admin','Dashboard'], ['/admin/calendar','ปฏิทินการจอง'],
        ['sec','การขาย'], ['/admin/orders','คำสั่งซื้อ', adminNav.pending], ['/admin/users','ลูกค้า & สิทธิ์'],
        ['sec','สินค้า'], ['/admin/products','สินค้าทั้งหมด'], ['/admin/inventory','สต็อก (SKU)'], ['/admin/categories','ประเภทสินค้า'],
        ['sec','ระบบ'], ['/admin/settings','ตั้งค่าร้าน'], ['/admin/system','การเชื่อมต่อ & สำรองข้อมูล'], ['/admin/audit','ประวัติการแก้ไข'],
      ]; %>
      <% nav.forEach(n => { if (n[0] === 'sec') { %><div class="sec"><%= n[1] %></div><% } else {
        const on = n[0] === '/admin' ? (path === '/admin' || path === '/admin/') : (path === n[0] || path.startsWith(n[0] + '/')); %>
        <a href="<%= n[0] %>" class="<%= on ? 'on' : '' %>"><span><%= n[1] %></span><% if (n[2]) { %><span class="count"><%= n[2] %></span><% } %></a>
      <% } }) %>
      <div class="sec">ลิงก์</div>
      <% if (sheetUrl) { %><a href="<%= sheetUrl %>" target="_blank" rel="noopener">เปิด Google Sheets ↗</a><% } %>
      <a href="/" target="_blank">ดูหน้าร้าน ↗</a>
    </nav>
    <form method="post" action="/logout" style="padding:16px 12px"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="small" style="color:#a39b8f;margin-bottom:8px"><%= user.display_name %></div>
      <button class="btn sm secondary" style="color:#d9d3ca;border-color:#3b3732">ออกจากระบบ</button>
    </form>
  </aside>
  <div class="admin-main">
    <div class="admin-top">
      <button class="menu-toggle" data-toggle="#sidebar" aria-label="เมนู">☰</button>
      <h1><%= title %></h1>
      <div style="margin-left:auto" class="row"><%- typeof topActions !== 'undefined' ? topActions : '' %></div>
    </div>
    <div class="admin-body">
    <% if (flash) { %><div class="flash <%= flash.type %>" style="margin-top:0"><%= flash.msg %></div><% } %>

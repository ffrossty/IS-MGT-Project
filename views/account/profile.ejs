<%- include('../partials/header') %>
<div class="container narrow" style="padding-top:30px">
  <h1>บัญชีของฉัน</h1>
  <div class="card">
    <div class="row">
      <% if (user.picture_url) { %><img class="avatar" style="width:64px;height:64px" src="<%= user.picture_url %>" alt=""><% } else { %><span class="avatar" style="width:64px;height:64px;font-size:1.4rem"><%= user.display_name.slice(0,1) %></span><% } %>
      <div>
        <div style="font-size:1.15rem;font-weight:500"><%= user.display_name %></div>
        <div class="small muted">เข้าสู่ระบบด้วย <%= user.line_user_id.startsWith('dev-') ? 'Dev Login (ทดสอบ)' : 'LINE' %> · สมาชิกตั้งแต่ <%= T.date(user.created_at) %></div>
      </div>
    </div>
    <hr>
    <dl class="kv">
      <dt>LINE User ID</dt><dd class="mono"><%= user.line_user_id %></dd>
      <dt>สิทธิ์</dt><dd><%= user.role === 'admin' ? 'Admin' : 'Customer' %></dd>
      <dt>เบอร์โทร</dt><dd><%= user.phone || '-' %></dd>
      <dt>การแจ้งเตือน LINE</dt><dd>
        <% if (user.is_friend === 1) { %><span class="badge ok">เป็นเพื่อนกับ LINE OA แล้ว</span>
        <% } else if (config.oaBasicId) { %><span class="badge warn">ยังไม่ได้เพิ่มเพื่อน</span> <a class="link small" href="https://line.me/R/ti/p/<%= encodeURIComponent(config.oaBasicId) %>" target="_blank" rel="noopener">เพิ่มเพื่อน <%= config.oaBasicId %></a> เพื่อรับแจ้งเตือน
        <% } else { %><span class="muted">-</span><% } %>
      </dd>
    </dl>
    <hr>
    <div class="row">
      <a class="btn secondary" href="/orders">ประวัติการจอง</a>
      <% if (isAdmin) { %><a class="btn secondary" href="/admin">ไปหน้า Admin</a><% } %>
      <form method="post" action="/logout" style="margin-left:auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger">ออกจากระบบ</button></form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

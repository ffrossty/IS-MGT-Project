<%- include('../partials/admin-header', { topActions: `<a class="btn sm secondary" href="/admin/products/${p.id}">แก้ไขสินค้า</a>` }) %>
<div class="grid-2 wide-left" style="align-items:start">
  <div class="card">
    <div class="toolbar" style="margin-bottom:8px">
      <a class="btn secondary sm" href="?month=<%= prev %>">‹</a><h3 style="margin:0 8px"><%= monthLabel %></h3><a class="btn secondary sm" href="?month=<%= next %>">›</a>
    </div>
    <p class="small muted">ตัวเลข = จำนวนชุดที่ว่างตลอดทั้งวันนั้น (หักการจอง ช่วงเตรียม/ทำความสะอาด และการปิดชั่วคราวแล้ว)</p>
    <div class="table-wrap"><table class="heat">
      <thead><tr><th class="label">ไซส์ (สต็อก)</th><% grid[0] && grid[0].days.forEach(d => { %><th><%= d.d %></th><% }) %></tr></thead>
      <tbody>
        <% grid.forEach(g => { %><tr><th class="label"><%= g.sku.size_label %> (<%= g.sku.stock_qty %>)</th>
          <% g.days.forEach(d => { %><td class="<%= d.free === 0 ? 'f0' : d.free < g.sku.stock_qty ? 'f1' : 'f2' %> <%= d.dow === 0 || d.dow === 6 ? 'we' : '' %>"><%= d.free %></td><% }) %></tr>
        <% }) %>
      </tbody>
    </table></div>
    <% if (!grid.length) { %><p class="muted">ยังไม่มีไซส์ — เพิ่มไซส์ในหน้าแก้ไขสินค้า</p><% } %>

    <h3 style="margin-top:24px">การจองที่ยังไม่เสร็จสิ้น</h3>
    <table class="table"><thead><tr><th>Order</th><th>ไซส์</th><th>เริ่ม → คืน</th><th>ล็อกสต็อก (รวมเตรียม/ทำความสะอาด)</th><th>สถานะ</th></tr></thead><tbody>
      <% bookings.forEach(b => { %><tr class="clickable" data-href="/admin/orders/<%= b.code %>"><td class="mono"><%= b.code %></td><td><%= b.size_label %> ×<%= b.qty %></td><td class="small nowrap"><%= T.dt(b.start_at) %><br><%= T.dt(b.due_at) %></td><td class="small nowrap muted"><%= T.dt(b.block_start) %><br><%= T.dt(b.block_end) %></td><td><%- h.orderBadge(b.status) %></td></tr><% }) %>
      <% if (!bookings.length) { %><tr><td colspan="5" class="muted small">ไม่มี</td></tr><% } %>
    </tbody></table>
  </div>

  <div class="stack">
    <div class="card">
      <h3>ปิดชุดชั่วคราว / ไม่พร้อมให้เช่า</h3>
      <p class="small muted">ใช้เมื่อชุดอยู่ระหว่างซัก ซ่อม ตรวจสภาพ หรือถูกจองนอกระบบ ระบบจะไม่ให้ลูกค้าจองในช่วงนี้</p>
      <form method="post" action="/admin/products/<%= p.id %>/blocks">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="form-grid">
          <div class="field"><label class="req">ไซส์</label><select name="sku_id" required><% grid.forEach(g => { %><option value="<%= g.sku.id %>"><%= g.sku.size_label %> (สต็อก <%= g.sku.stock_qty %>)</option><% }) %></select></div>
          <div class="field"><label class="req">จำนวน</label><input type="number" name="qty" value="1" min="1"></div>
          <div class="field"><label class="req">ตั้งแต่</label><input type="datetime-local" name="start" required></div>
          <div class="field"><label class="req">ถึง</label><input type="datetime-local" name="end" required></div>
          <div class="field full"><label class="req">เหตุผล</label><select name="reason"><% Object.entries(L.BLOCK_REASON).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select></div>
          <div class="field full"><label>หมายเหตุ</label><input type="text" name="note" maxlength="300"></div>
        </div>
        <button class="btn block">บันทึก</button>
      </form>
    </div>
    <div class="card">
      <h3>ช่วงที่ปิดไว้</h3>
      <% if (!blocks.length) { %><p class="muted small">ไม่มี</p><% } %>
      <ul class="event-list">
        <% blocks.forEach(b => { %><li class="row between"><div><strong><%= L.BLOCK_REASON[b.reason] %></strong> · ไซส์ <%= b.size_label %> ×<%= b.qty %><div class="small muted"><%= T.dt(b.start_at) %> → <%= T.dt(b.end_at) %><%= b.note ? ' · ' + b.note : '' %></div></div>
          <form method="post" action="/admin/blocks/<%= b.id %>/delete" data-confirm="ยกเลิกการปิดช่วงนี้?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm danger">ลบ</button></form></li><% }) %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/admin-footer') %>

<%- include('../partials/admin-header') %>
<form method="get" class="toolbar card" style="padding:14px">
  <div class="field grow"><label>ค้นหา</label><input type="search" name="q" value="<%= query.q || '' %>" placeholder="Order ID / ชื่อ / เบอร์โทร / Tracking"></div>
  <div class="field"><label>สถานะคำสั่งซื้อ</label><select name="status"><option value="">ทั้งหมด</option><% Object.entries(L.ORDER_STATUS).forEach(([k, v]) => { %><option value="<%= k %>" <%= query.status === k ? 'selected' : '' %>><%= v.th %></option><% }) %></select></div>
  <div class="field"><label>การชำระเงิน</label><select name="payment"><option value="">ทั้งหมด</option><% Object.entries(L.PAYMENT_STATUS).forEach(([k, v]) => { %><option value="<%= k %>" <%= query.payment === k ? 'selected' : '' %>><%= v.th %></option><% }) %></select></div>
  <div class="field"><label>สั่งจองตั้งแต่</label><input type="date" name="from" value="<%= query.from || '' %>"></div>
  <div class="field"><label>ถึง</label><input type="date" name="to" value="<%= query.to || '' %>"></div>
  <div class="field"><label>ช่วงเช่าตั้งแต่</label><input type="date" name="rent_from" value="<%= query.rent_from || '' %>"></div>
  <div class="field"><label>ถึง</label><input type="date" name="rent_to" value="<%= query.rent_to || '' %>"></div>
  <label class="checkbox" style="align-self:center"><input type="checkbox" name="all" value="1" <%= query.all === '1' ? 'checked' : '' %>> รวมออเดอร์ที่ยังไม่แนบสลิป</label>
  <button class="btn sm">กรอง</button><a class="btn sm ghost" href="/admin/orders">ล้าง</a>
</form>
<div class="small muted row" style="margin-bottom:8px;gap:8px">
  <span>พบ <%= total %> รายการ<%= showAll ? '' : ' (เฉพาะออเดอร์ที่ลูกค้าแนบสลิปแล้ว)' %></span>
  <% if (!showAll && hiddenCount) { %>· <span>ซ่อน <%= hiddenCount %> ออเดอร์ที่ยังไม่แนบสลิป</span> <a class="link" href="<%= h.qs(query, { all: '1', page: '' }) %>">แสดงทั้งหมด</a>
  <% } else if (query.all === '1') { %>· <a class="link" href="<%= h.qs(query, { all: '', page: '' }) %>">ซ่อนออเดอร์ที่ยังไม่แนบสลิป</a><% } %>
</div>
<div class="card" style="padding:0"><div class="table-wrap"><table class="table">
  <thead><tr><th>Order ID</th><th>สั่งจองเมื่อ</th><th>ลูกค้า</th><th>สินค้า</th><th>ช่วงเช่า</th><th class="right">ยอดรวม</th><th>สถานะ</th><th>ชำระเงิน</th><th>จัดส่ง</th><th>ส่งคืน</th></tr></thead>
  <tbody>
  <% orders.forEach(o => { %>
    <tr class="clickable" data-href="/admin/orders/<%= o.code %>">
      <td class="mono nowrap"><a href="/admin/orders/<%= o.code %>"><%= o.code %></a><% if (o.review_overdue && o.status === 'pending_approval') { %><div><span class="badge bad">เกินเวลาตรวจ</span></div><% } %></td>
      <td class="nowrap small"><%= T.dt(o.created_at) %></td>
      <td><%= o.recipient_name %><div class="small muted"><%= o.phone %></div></td>
      <td class="small" style="max-width:260px"><%= o.items_text %></td>
      <td class="nowrap small"><%= T.dt(o.first_start) %><br><span class="muted">คืน <%= T.dt(o.last_due) %></span></td>
      <td class="right nowrap"><%= baht(o.total) %><div class="small muted"><%= o.shipping_method === 'ems' ? 'ส่งพัสดุ' : 'Express' %></div></td>
      <td><%- h.orderBadge(o.status) %></td>
      <td><%- h.paymentBadge(o.payment_status) %></td>
      <td><%- h.shippingBadge(o.shipping_status) %></td>
      <td class="small" style="max-width:200px">
        <% if (o.status === 'returned' || o.status === 'completed') { %><span class="badge ok">รับคืนแล้ว</span>
        <% } else if (o.return_submitted_at) { %><span class="badge info">ลูกค้ากำลังส่งคืน</span>
          <div style="margin-top:4px;word-break:break-all"><%= o.return_method === 'express' ? 'ส่งด่วน' : (o.return_carrier || 'ส่งพัสดุ') %> · <%- h.trackingHtml(o.return_tracking) %></div>
        <% } else { %><span class="muted">-</span><% } %>
      </td>
    </tr>
  <% }) %>
  <% if (!orders.length) { %><tr><td colspan="10" class="center muted" style="padding:40px">ไม่พบคำสั่งซื้อ</td></tr><% } %>
  </tbody>
</table></div></div>
<% if (pages > 1) { %><div class="pager"><% for (let i = 1; i <= pages; i++) { %><a class="btn sm <%= i === page ? '' : 'secondary' %>" href="<%= h.qs(query, { page: i }) %>"><%= i %></a><% } %></div><% } %>
<%- include('../partials/admin-footer') %>

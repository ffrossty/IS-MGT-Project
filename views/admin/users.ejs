<%- include('../partials/admin-header') %>
<div class="card" style="padding:0"><div class="table-wrap"><table class="table">
  <thead><tr><th>ผู้ใช้</th><th>LINE User ID</th><th>เบอร์โทร</th><th class="right">คำสั่งซื้อ</th><th class="right">ยอดชำระแล้ว</th><th>เข้าสู่ระบบล่าสุด</th><th>สิทธิ์</th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <tr>
      <td class="row" style="flex-wrap:nowrap"><% if (u.picture_url) { %><img class="avatar" src="<%= u.picture_url %>" alt=""><% } else { %><span class="avatar"><%= u.display_name.slice(0,1) %></span><% } %> <span><%= u.display_name %><% if (u.line_user_id.startsWith('dev-')) { %> <span class="badge muted">dev</span><% } %></span></td>
      <td class="mono small"><%= u.line_user_id %></td>
      <td><%= u.phone || '-' %></td>
      <td class="right"><a class="link" href="/admin/orders?q=<%= encodeURIComponent(u.phone || u.display_name) %>"><%= u.orders %></a></td>
      <td class="right"><%= baht(u.spent) %></td>
      <td class="small nowrap"><%= T.dt(u.last_login_at) %></td>
      <td>
        <form method="post" action="/admin/users/<%= u.id %>/role" class="row" style="gap:6px;flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <select name="role" data-autosubmit style="width:auto;padding:5px 10px" <%= u.id === user.id || envAdmins.includes(u.line_user_id) ? 'disabled' : '' %>>
            <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>Customer</option>
            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>
          <% if (envAdmins.includes(u.line_user_id)) { %><span class="small muted">(.env)</span><% } %>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table></div></div>
<p class="small muted" style="margin-top:12px">Admin กำหนดได้ 2 ทาง: (1) ใส่ LINE User ID ใน <span class="mono">ADMIN_LINE_USER_IDS</span> ของไฟล์ .env หรือ (2) ให้ Admin คนอื่นเปลี่ยนสิทธิ์ที่หน้านี้ · ระบบตรวจสิทธิ์จากฐานข้อมูลทุกคำขอ</p>
<%- include('../partials/admin-footer') %>

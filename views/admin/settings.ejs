<%- include('../partials/admin-header') %>
<% const s = settings; const inp = (k, label, hint, type) => `<div class="field"><label>${label}</label><input type="${type||'text'}" name="${k}" value="${h.esc(s[k])}">${hint ? `<div class="hint">${hint}</div>` : ''}</div>`; %>
<form method="post" action="/admin/settings?_csrf=<%= csrf %>" enctype="multipart/form-data" class="grid-2" style="align-items:start">
  <div class="stack">
    <div class="card"><h3>ข้อมูลร้าน</h3>
      <%- inp('shop_name', 'ชื่อร้าน') %><%- inp('shop_tagline', 'คำโปรย') %>
      <div class="form-grid"><%- inp('shop_phone', 'เบอร์โทรร้าน') %><%- inp('shop_line_url', 'ลิงก์ LINE OA', 'เช่น https://lin.ee/xxxx') %></div>
      <%- inp('google_sheet_url', 'ลิงก์ Google Sheets (ไม่บังคับ)', 'เว้นว่างเพื่อใช้ลิงก์จาก GOOGLE_SHEETS_SPREADSHEET_ID อัตโนมัติ') %>
    </div>
    <div class="card"><h3>การจัดส่ง</h3>
      <%- inp('ems_fee', 'ค่าส่ง EMS (บาท/คำสั่งซื้อ)', '', 'number') %>
      <%- inp('express_origin', 'ต้นทางสำหรับ Express Delivery', 'แสดงเป็น “ค่าส่งตามจริง ณ เวลานั้น ๆ (ต้นทาง: …)”') %>
    </div>
    <div class="card"><h3>การชำระเงิน</h3>
      <div class="form-grid"><%- inp('promptpay_id', 'PromptPay ID', 'เบอร์มือถือ 10 หลัก หรือเลขประจำตัว 13 หลัก — ระบบสร้าง QR พร้อมยอดเงินอัตโนมัติ') %><%- inp('promptpay_name', 'ชื่อบัญชี (แสดงให้ลูกค้า)') %></div>
      <div class="field"><label>หรือ อัปโหลดรูป QR Code ของร้าน</label>
        <% if (s.payment_qr_image) { %><img src="/media/settings/<%= s.payment_qr_image %>" alt="" style="width:140px;border-radius:8px;border:1px solid var(--line);margin-bottom:8px"><label class="checkbox"><input type="checkbox" name="remove_qr" value="1"> ลบรูปนี้</label><% } %>
        <input type="file" name="payment_qr" accept="image/png,image/jpeg,image/webp" data-max-mb="5"><div class="hint">ใช้เมื่อไม่ได้ตั้งค่า PromptPay ID (QR แบบคงที่ ลูกค้าต้องกรอกยอดเอง)</div></div>
    </div>
  </div>
  <div class="stack">
    <div class="card"><h3>การจองและการล็อกสต็อก</h3>
      <div class="form-grid">
        <%- inp('payment_hold_minutes', 'ล็อกสต็อกระหว่างรอชำระเงิน (นาที)', 'ถ้าลูกค้าไม่อัปโหลดสลิปภายในเวลานี้ ระบบคืนสต็อกอัตโนมัติ', 'number') %>
        <%- inp('admin_review_hours', 'เวลาให้แอดมินตรวจสลิป (ชั่วโมง)', 'เกินเวลาจะแจ้งเตือนบน Dashboard', 'number') %>
      </div>
      <label class="checkbox"><input type="checkbox" name="auto_expire_unreviewed" value="1" <%= s.auto_expire_unreviewed === '1' ? 'checked' : '' %>> ปลดล็อกสต็อกอัตโนมัติหากแอดมินไม่ตรวจสอบภายในเวลาที่กำหนด</label>
      <p class="hint small muted">ค่าเริ่มต้น: ปิด (ลูกค้าโอนเงินแล้ว จึงคงการล็อกไว้และแจ้งเตือนแอดมินแทน)</p>
      <hr>
      <div class="form-grid">
        <%- inp('buffer_before_hours', 'เวลาเตรียมชุดก่อนเริ่มเช่า (ชม.)', 'ค่าเริ่มต้นของทุกสินค้า', 'number') %>
        <%- inp('buffer_after_hours', 'เวลาตรวจสอบ/ทำความสะอาดหลังคืน (ชม.)', 'ค่าเริ่มต้นของทุกสินค้า', 'number') %>
        <%- inp('pickup_start_hour', 'เวลารับ/คืนชุดเริ่ม (ชั่วโมง 0-23)', '', 'number') %>
        <%- inp('pickup_end_hour', 'เวลารับ/คืนชุดสิ้นสุด (ชั่วโมง 0-23)', '', 'number') %>
        <%- inp('min_advance_hours', 'ต้องจองล่วงหน้าอย่างน้อย (ชม.)', '', 'number') %>
        <%- inp('max_advance_days', 'จองล่วงหน้าได้ไม่เกิน (วัน)', '', 'number') %>
      </div>
      <%- inp('duration_options', 'ระยะเวลาเช่าที่เปิดให้เลือก (วัน)', 'คั่นด้วย comma เช่น 1,2,3,5,7 — คำนวณเป็นชั่วโมง (1 วัน = 24 ชม.)') %>
    </div>
    <div class="card"><h3>เงื่อนไขการเช่า (ทั่วไป)</h3><textarea name="rental_terms" rows="6"><%= s.rental_terms %></textarea></div>
    <button class="btn block">บันทึกการตั้งค่า</button>
  </div>
</form>
<%- include('../partials/admin-footer') %>

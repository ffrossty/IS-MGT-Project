<%- include('../partials/admin-header') %>
<form method="get" class="toolbar card" style="padding:14px">
  <div class="field"><label>ปี</label><select name="year">
    <% for (let y = new Date().getFullYear() + 1; y >= new Date().getFullYear() - 4; y--) { %><option value="<%= y %>" <%= r.year === y ? 'selected' : '' %>><%= y + 543 %></option><% } %>
  </select></div>
  <div class="field"><label>เดือน</label><select name="month">
    <option value="all" <%= !r.month && !r.custom ? 'selected' : '' %>>ทั้งปี</option>
    <% ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'].forEach((m, i) => { %><option value="<%= i+1 %>" <%= r.month === i+1 ? 'selected' : '' %>><%= m %></option><% }) %>
  </select></div>
  <div class="field"><label>หรือ ตั้งแต่วันที่</label><input type="date" name="from" value="<%= query.from || '' %>"></div>
  <div class="field"><label>ถึงวันที่</label><input type="date" name="to" value="<%= query.to || '' %>"></div>
  <button class="btn sm">แสดงผล</button>
  <span class="muted small" style="margin-left:auto">ช่วงข้อมูล: <strong><%= r.label %></strong></span>
</form>

<div class="stats five">
  <div class="stat hl"><div class="k">รายได้รวม (ชำระแล้ว)</div><div class="v"><%= baht(stats.revenue) %></div><div class="s"><%= r.label %></div></div>
  <a class="stat" href="/admin/orders"><div class="k">คำสั่งซื้อทั้งหมด</div><div class="v"><%= stats.total %></div><div class="s">ที่แนบสลิปแล้ว ในช่วงที่เลือก</div></a>
  <a class="stat <%= stats.pendingApproval ? 'alert' : '' %>" href="/admin/orders?status=pending_approval"><div class="k">รอการยืนยัน</div><div class="v"><%= stats.pendingApproval %></div><div class="s"><%= stats.overdueReview ? `เกินเวลาตรวจ ${stats.overdueReview} รายการ` : 'สต็อกถูกล็อกไว้' %></div></a>
  <a class="stat" href="/admin/orders?status=pending_approval&payment=submitted"><div class="k">รอตรวจสอบสลิป</div><div class="v"><%= stats.slipToCheck %></div><div class="s">ลูกค้าส่งสลิปแล้ว</div></a>
  <a class="stat" href="/admin/orders?status=awaiting_payment"><div class="k">รอลูกค้าชำระเงิน</div><div class="v"><%= stats.awaitingPayment %></div><div class="s">ล็อกสต็อกชั่วคราว</div></a>
  <a class="stat" href="/admin/orders?status=confirmed"><div class="k">ยืนยันแล้ว</div><div class="v"><%= stats.confirmed %></div><div class="s">ในช่วงที่เลือก</div></a>
  <div class="stat"><div class="k">ชุดที่กำลังถูกเช่า</div><div class="v"><%= stats.renting %></div><div class="s">ชิ้น ณ ขณะนี้</div></div>
  <div class="stat <%= stats.awaitingReturn ? 'alert' : '' %>"><div class="k">ชุดที่รอคืน</div><div class="v"><%= stats.awaitingReturn %></div><div class="s">ครบกำหนด/เลยกำหนดภายใน 24 ชม.</div></div>
  <a class="stat" href="/admin/orders?status=completed"><div class="k">เสร็จสิ้น</div><div class="v"><%= stats.completed %></div><div class="s">ในช่วงที่เลือก</div></a>
  <a class="stat" href="/admin/calendar"><div class="k">ปฏิทินภาพรวม</div><div class="v" style="font-size:1.2rem;margin-top:10px">เปิดปฏิทิน →</div></a>
</div>

<div class="grid-2 wide-left" style="margin-top:20px;align-items:start">
  <div class="card">
    <div class="card-title"><h3>รายได้<%= byDay ? 'รายวัน' : 'รายเดือน' %></h3><span class="small muted"><%= r.label %></span></div>
    <% const max = Math.max(1, ...series.map(s => s.value)); %>
    <div class="bars">
      <% series.forEach(s => { %>
        <div class="b"><div class="col <%= s.value ? '' : 'zero' %>" style="height:<%= Math.max(1, Math.round(s.value / max * 100)) %>%"><span class="tip"><%= s.key %> · <%= baht(s.value) %></span></div><div class="lab"><%= s.label %></div></div>
      <% }) %>
    </div>
  </div>
  <div class="card">
    <h3>สินค้ายอดนิยม</h3>
    <% if (!popular.length) { %><p class="muted small">ยังไม่มีข้อมูลในช่วงนี้</p><% } %>
    <table class="table"><tbody>
      <% popular.forEach((p, i) => { %><tr><td class="muted"><%= i+1 %></td><td><a class="link" href="/admin/products/<%= p.product_id %>"><%= p.product_name %></a></td><td class="right nowrap"><%= p.qty %> ครั้ง</td><td class="right nowrap"><%= baht(p.revenue) %></td></tr><% }) %>
    </tbody></table>
  </div>
</div>

<div class="grid-2" style="margin-top:20px;align-items:start">
  <div class="card">
    <div class="card-title"><h3>ต้องตรวจสอบ</h3><a class="link small" href="/admin/orders?status=pending_approval">ดูทั้งหมด</a></div>
    <% if (!attention.length) { %><p class="muted small">ไม่มีคำสั่งซื้อที่รอการยืนยัน</p><% } %>
    <table class="table"><tbody>
    <% attention.forEach(o => { %>
      <tr class="clickable" data-href="/admin/orders/<%= o.code %>">
        <td class="mono"><%= o.code %><div class="small muted"><%= o.recipient_name %></div></td>
        <td><%= baht(o.total) %></td>
        <td class="small"><%= o.slip_uploaded_at ? 'ส่งสลิป ' + T.dt(o.slip_uploaded_at) : '' %><% if (o.review_overdue) { %><div><span class="badge bad">เกินเวลาตรวจสอบ</span></div><% } %></td>
      </tr>
    <% }) %>
    </tbody></table>
  </div>
  <div class="card">
    <h3>กำหนดคืนชุด (ภายใน 48 ชม. / เลยกำหนด)</h3>
    <% if (!returns.length) { %><p class="muted small">ไม่มีชุดที่ใกล้ครบกำหนดคืน</p><% } %>
    <table class="table"><tbody>
    <% returns.forEach(i => { %>
      <tr class="clickable" data-href="/admin/orders/<%= i.code %>">
        <td><%= i.product_name %><%= h.sz(i.size_label) %> ×<%= i.qty %><div class="small muted mono"><%= i.code %> · <%= i.recipient_name %></div></td>
        <td class="nowrap small"><%= T.dt(i.due_at) %><% if (i.due_at < Date.now()) { %><div><span class="badge bad">เลยกำหนด</span></div><% } %></td>
      </tr>
    <% }) %>
    </tbody></table>
    <h3 style="margin-top:20px">เริ่มเช่าใน 3 วัน (ต้องเตรียมจัดส่ง)</h3>
    <% if (!upcoming.length) { %><p class="muted small">ไม่มีรายการ</p><% } %>
    <table class="table"><tbody>
    <% upcoming.forEach(i => { %>
      <tr class="clickable" data-href="/admin/orders/<%= i.code %>">
        <td><%= i.product_name %><%= h.sz(i.size_label) %> ×<%= i.qty %><div class="small muted mono"><%= i.code %></div></td>
        <td class="nowrap small"><%= T.dt(i.start_at) %></td><td><%- h.shippingBadge(i.shipping_status) %></td>
      </tr>
    <% }) %>
    </tbody></table>
  </div>
</div>
<%- include('../partials/admin-footer') %>

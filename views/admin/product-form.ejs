<%- include('../partials/admin-header', { topActions: p.id ? `<a class="btn sm secondary" href="/products/${p.id}" target="_blank">ดูหน้าร้าน ↗</a> <a class="btn sm secondary" href="/admin/products/${p.id}/calendar">ปฏิทิน / ปิดวันว่าง</a>` : '' }) %>
<form method="post" action="/admin/products<%= p.id ? '/' + p.id : '' %>?_csrf=<%= csrf %>" enctype="multipart/form-data" class="grid-2 wide-left" style="align-items:start">
  <div class="stack">
    <div class="card">
      <h3>ข้อมูลสินค้า</h3>
      <div class="field"><label class="req">ชื่อสินค้า</label><input type="text" name="name" value="<%= p.name || '' %>" required maxlength="150"></div>
      <div class="form-grid">
        <div class="field"><label>ประเภทสินค้า</label><select name="category_id"><option value="">- ไม่ระบุ -</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select><div class="hint"><a class="link" href="/admin/categories">จัดการประเภท</a></div></div>
        <div class="field"><label class="checkbox" style="margin-top:28px"><input type="checkbox" name="is_active" value="1" <%= p.is_active ? 'checked' : '' %>> แสดงสินค้าบนหน้าร้าน</label></div>
      </div>
      <div class="field"><label>รายละเอียดสินค้า</label><textarea name="description" rows="5"><%= p.description || '' %></textarea></div>
      <div class="field"><label>เงื่อนไขการเช่าเฉพาะสินค้านี้</label><textarea name="conditions" rows="3" placeholder="เช่น ห้ามใช้น้ำหอมฉีดโดยตรง, ค่ามัดจำ ฯลฯ"><%= p.conditions || '' %></textarea><div class="hint">แสดงร่วมกับเงื่อนไขทั่วไปของร้าน (ตั้งค่าร้าน)</div></div>
      <div class="field"><label>ตารางขนาด (Size Chart)</label><textarea name="size_chart" rows="5" class="mono" placeholder="Size, อก, เอว, ความยาว&#10;S, 32, 26, 50&#10;M, 34, 28, 51"><%= p.size_chart || '' %></textarea><div class="hint">บรรทัดแรกเป็นหัวตาราง คั่นแต่ละคอลัมน์ด้วย , หรือ |</div></div>
    </div>

    <div class="card">
      <div class="card-title"><h3>ไซส์และสต็อก (SKU)</h3><button type="button" class="btn sm secondary" data-add-row="#new-sizes">+ เพิ่มไซส์</button></div>
      <table class="table">
        <thead><tr><th>ไซส์</th><th>จำนวนสต็อก (ตัว)</th><th></th></tr></thead>
        <tbody>
          <% skus.forEach(s => { %>
            <tr><td><input type="text" name="size_<%= s.id %>" value="<%= s.size_label %>" maxlength="30"></td>
              <td><input type="number" name="qty_<%= s.id %>" value="<%= s.stock_qty %>" min="0"></td>
              <td><button class="btn sm danger" form="del-sku-<%= s.id %>">ลบ</button></td></tr>
          <% }) %>
        </tbody>
        <tbody id="new-sizes">
          <tr><td><input type="text" name="new_size[]" placeholder="<%= skus.length ? 'ไซส์ใหม่ เช่น XL' : 'เช่น Free size / S / M' %>" maxlength="30"></td><td><input type="number" name="new_qty[]" value="1" min="0" data-default="1"></td><td></td></tr>
        </tbody>
      </table>
      <p class="small muted">สต็อก = จำนวนชุดจริงที่ร้านมีในไซส์นั้น ระบบคำนวณจำนวนว่างตามช่วงเวลาจากการจองอัตโนมัติ · ปิดชุดชั่วคราว (ซ่อม/ซัก) ได้ที่หน้า <strong>ปฏิทิน</strong></p>
    </div>

    <div class="card" id="images">
      <h3>รูปภาพสินค้า</h3>
      <% if (images.length) { %>
        <div class="img-grid" style="margin-bottom:14px">
          <% images.forEach((im, i) => { %>
            <div class="it"><img src="<%= h.img(im.filename) %>" alt="">
              <div class="acts">
                <% if (i === 0) { %><span class="badge ok">ภาพหลัก</span><% } else { %><button class="btn sm ghost" form="pri-img-<%= im.id %>">ตั้งเป็นภาพหลัก</button><% } %>
                <button class="btn sm danger" form="del-img-<%= im.id %>">ลบ</button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <label class="dropzone" data-dropzone><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple data-max-mb="10"><strong>อัปโหลดรูปภาพ</strong><div class="small muted">เลือกได้หลายไฟล์ · แนะนำอัตราส่วน 3:4</div><img class="preview" alt="" hidden></label>
    </div>
  </div>

  <div class="stack" style="position:sticky;top:80px">
    <% const tierRows = pricing.tiers(p.id ? p : { price_tiers: p.price_tiers, promo_type: null, base_days: 1, base_price: 0 }); %>
    <div class="card">
      <div class="card-title"><h3>ราคาเช่า</h3><button type="button" class="btn sm secondary" data-add-row="#tier-rows">+ เพิ่มแถว</button></div>
      <table class="table">
        <thead><tr><th>จำนวนวัน</th><th>ราคา (บาท)</th><th></th></tr></thead>
        <tbody id="tier-rows">
          <% tierRows.forEach(t => { %>
            <tr><td><input type="number" name="tier_days[]" value="<%= t.days %>" min="1" style="width:90px"></td>
              <td><input type="number" name="tier_price[]" value="<%= t.price %>" min="0"></td>
              <td><button type="button" class="btn sm ghost" data-remove-row title="ลบแถว">✕</button></td></tr>
          <% }) %>
        </tbody>
      </table>
      <div class="field" style="margin-top:12px"><label>ค่าเช่าวันที่เกินจากตาราง (บาท/วัน)</label><input type="number" name="extra_day_price" value="<%= p.extra_day_price || 0 %>" min="0">
        <div class="hint">ใช้เมื่อลูกค้าเลือกจำนวนวันที่ไม่มีในตาราง เช่น ตาราง 1 วัน 350 · 3 วัน 450 + วันละ 50 → เช่า 4 วัน = 500 บาท · ลบแถวให้เว้นช่องราคาว่าง</div></div>
    </div>

    <div class="card">
      <h3>โปรโมชั่นชุดนี้</h3>
      <div class="form-grid">
        <div class="field"><label>ส่วนลด</label><select name="promo_type" data-promo-type>
          <option value="">ไม่มีโปรโมชั่น</option>
          <option value="percent" <%= p.promo_type === 'percent' ? 'selected' : '' %>>ลดเป็น %</option>
          <option value="amount" <%= p.promo_type === 'amount' ? 'selected' : '' %>>ลดเป็นบาท</option></select></div>
        <div class="field"><label>มูลค่าส่วนลด</label><input type="number" name="promo_value" min="0" value="<%= p.promo_value || '' %>" placeholder="เช่น 10"></div>
        <div class="field"><label>เริ่ม (ไม่บังคับ)</label><input type="datetime-local" name="promo_start" value="<%= p.promo_start ? T.toInputDateTime(p.promo_start) : '' %>"></div>
        <div class="field"><label>สิ้นสุด (ไม่บังคับ)</label><input type="datetime-local" name="promo_end" value="<%= p.promo_end ? T.toInputDateTime(p.promo_end) : '' %>"></div>
        <div class="field full"><label>ชื่อโปรโมชั่น (แสดงให้ลูกค้าเห็น)</label><input type="text" name="promo_label" maxlength="60" value="<%= p.promo_label || '' %>" placeholder="เช่น ลดรับปีใหม่"></div>
      </div>
      <p class="hint small muted">ลดจากทุกแถวในตารางราคา · ถ้ามีโปรทั้งร้านด้วย ลูกค้าได้ส่วนลดที่มากกว่า (ไม่ลดซ้อน) · โปรทั้งร้านตั้งได้ที่ ตั้งค่าร้าน</p>
      <% if (p.id) { const d = pricing.priceDetail(p, tierRows[0].days); if (d.promo) { %><p class="small" style="color:var(--ok)">ตอนนี้ลูกค้าเห็น: <s class="muted"><%= baht(d.original) %></s> <strong><%= baht(d.price) %></strong> / <%= tierRows[0].days %> วัน</p><% } } %>
    </div>
    <div class="card">
      <h3>เวลาเตรียมชุด & ทำความสะอาด</h3>
      <div class="field"><label>ก่อนเริ่มเช่า (ชั่วโมง)</label><input type="number" name="buffer_before_hours" value="<%= p.buffer_before_hours ?? '' %>" min="0" placeholder="ค่าเริ่มต้น <%= defaults.before %>"><div class="hint">ช่วงเวลาเตรียม/แพ็ก/จัดส่ง ที่ชุดต้องไม่ถูกจองซ้อน</div></div>
      <div class="field"><label>หลังกำหนดคืน (ชั่วโมง)</label><input type="number" name="buffer_after_hours" value="<%= p.buffer_after_hours ?? '' %>" min="0" placeholder="ค่าเริ่มต้น <%= defaults.after %>"><div class="hint">ช่วงขนส่งคืน + ตรวจสอบ + ซัก/ทำความสะอาด ก่อนให้ลูกค้ารายถัดไปเช่า</div></div>
    </div>
    <button class="btn block" data-busy="กำลังบันทึก…"><%= p.id ? 'บันทึกการเปลี่ยนแปลง' : 'สร้างสินค้า' %></button>
    <% if (p.id) { %><button class="btn danger block" form="del-product" style="margin-top:4px">ลบสินค้า</button><% } %>
  </div>
</form>

<% skus.forEach(s => { %><form id="del-sku-<%= s.id %>" method="post" action="/admin/skus/<%= s.id %>/delete" data-confirm="ลบไซส์ <%= s.size_label %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"></form><% }) %>
<% images.forEach(im => { %>
  <form id="del-img-<%= im.id %>" method="post" action="/admin/images/<%= im.id %>/delete" data-confirm="ลบรูปนี้?"><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
  <form id="pri-img-<%= im.id %>" method="post" action="/admin/images/<%= im.id %>/primary"><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
<% }) %>
<% if (p.id) { %><form id="del-product" method="post" action="/admin/products/<%= p.id %>/delete" data-confirm="ลบสินค้า &quot;<%= p.name %>&quot;? ประวัติคำสั่งซื้อจะยังคงอยู่"><input type="hidden" name="_csrf" value="<%= csrf %>"></form><% } %>
<%- include('../partials/admin-footer') %>

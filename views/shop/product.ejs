<%- include('../partials/header') %>
<div class="container">
  <div class="small muted" style="margin-top:20px"><a href="/" class="link">คอลเลกชัน</a> / <%= p.name %></div>
  <% if (!p.is_active) { %><div class="flash warn">สินค้านี้ถูกซ่อนจากหน้าร้าน (คุณเห็นเพราะเป็น Admin)</div><% } %>
  <div class="pdp">
    <div class="gallery" data-gallery>
      <div class="main">
        <% if (images.length > 1) { %>
          <div class="g-stage" data-stage>
            <% images.forEach((im, i) => { %><img src="<%= h.img(im.filename) %>" alt="<%= p.name %> (<%= i + 1 %>/<%= images.length %>)" class="<%= i === 0 ? 'is-active' : '' %>" <%= i ? 'loading="lazy"' : '' %>><% }) %>
          </div>
          <button type="button" class="g-nav prev" data-step="-1" aria-label="รูปก่อนหน้า"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button type="button" class="g-nav next" data-step="1" aria-label="รูปถัดไป"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="g-count" data-count>1 / <%= images.length %></div>
        <% } else { %>
          <img src="<%= h.img(images[0] && images[0].filename) %>" alt="<%= p.name %>">
        <% } %>
      </div>
      <% if (images.length > 1) { %>
        <div class="thumbs">
          <% images.forEach((im, i) => { %><button type="button" class="<%= i===0?'active':'' %>" data-index="<%= i %>" aria-label="รูปที่ <%= i + 1 %>"><img src="<%= h.img(im.filename) %>" alt=""></button><% }) %>
        </div>
      <% } %>
    </div>

    <div class="pdp-info">
      <div class="eyebrow">Collection</div>
      <h1><%= p.name %></h1>
      <div class="pdp-price"><span data-price class="<%= firstPrice.promo ? 'sale' : '' %>"><%= baht(firstPrice.price) %></span> <s class="was" data-was <%= firstPrice.promo ? '' : 'hidden' %>><%= baht(firstPrice.original) %></s></div>
      <% if (firstPrice.promo) { %><div class="promo-banner">🏷️ <%= firstPrice.promo.label || 'โปรโมชั่น' %> — ลด <%= firstPrice.promo.type === 'percent' ? firstPrice.promo.value + '%' : baht(firstPrice.promo.value) + ' ต่อชุด' %><%= firstPrice.promo.end ? ' · ถึง ' + T.dt(firstPrice.promo.end) : '' %></div><% } %>
      <div class="price-table">
        <% priceRows.forEach(r => { %><div class="pt"><span><%= r.days %> วัน</span><strong><%= baht(r.price) %></strong><% if (r.promo) { %><s><%= baht(r.original) %></s><% } %></div><% }) %>
      </div>

      <% const MS = L.MEASURES.map(m => [m.ab, m.label + ' · ' + m.th, h.measureValue(p, m.col)]); const hasMS = MS.some(m => m[2] != null); %>
      <% if (p.size || hasMS) { %>
        <div class="pdp-fit">
          <% if (p.size) { %><div class="pdp-size"><span>ไซส์</span><strong><%= p.size %></strong></div><% } %>
          <% if (hasMS) { %>
            <div class="pdp-measures" aria-label="สัดส่วนชุด (นิ้ว)">
              <% MS.forEach(([ab, lab, v]) => { %><div class="m <%= v === 'Freesize' ? 'free' : '' %>"><span class="ab"><%= ab %></span><strong><%= v == null ? '–' : v %></strong><span class="lab"><%= lab %></span></div><% }) %>
            </div>
            <div class="small muted" style="margin-top:6px">ตัวเลขเป็นหน่วยนิ้ว</div>
          <% } %>
        </div>
      <% } %>

      <form method="post" action="/cart/add" id="book" data-product="<%= p.id %>" style="margin-top:22px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="product_id" value="<%= p.id %>">

        <% const legacy = skus.length > 1; const mainSku = skus.find(x => x.stock_qty > 0) || skus[0]; %>
        <% if (legacy) { %>
          <div class="field">
            <label>เลือกไซส์</label>
            <div class="size-select">
              <% skus.forEach((s, i) => { %>
                <input type="radio" name="sku_id" id="sku<%= s.id %>" value="<%= s.id %>" <%= s.stock_qty === 0 ? 'disabled' : '' %> <%= s === mainSku ? 'checked' : '' %>>
                <label for="sku<%= s.id %>"><%= s.size_label %><small>มี <%= s.stock_qty %> ตัว</small></label>
              <% }) %>
            </div>
          </div>
        <% } else if (mainSku) { %>
          <input type="hidden" name="sku_id" value="<%= mainSku.id %>" data-sku>
        <% } else { %>
          <p class="muted small">ชุดนี้ยังไม่เปิดให้จอง</p>
        <% } %>

        <div class="form-grid">
          <div class="field">
            <label for="b_date" class="req">วันเริ่มเช่า</label>
            <input type="date" id="b_date" name="start_date" value="<%= rental.date %>" min="<%= minDate %>" required>
          </div>
          <div class="field">
            <label for="b_time" class="req">เวลาเริ่มเช่า</label>
            <select id="b_time" name="start_time">
              <% timeOptions.forEach(t => { %><option value="<%= t %>" <%= defaultTime === t ? 'selected' : '' %>><%= t %> น.</option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="b_days" class="req">ระยะเวลาเช่า</label>
            <select id="b_days" name="days" required>
              <% durations.forEach(d => { %><option value="<%= d %>" <%= (rental.days || p.base_days) === d ? 'selected' : '' %>><%= d %> วัน (<%= d*24 %> ชั่วโมง)</option><% }) %>
            </select>
          </div>
          <div class="field">
            <label>จำนวน</label>
            <div class="qty" data-qty>
              <button type="button" data-step="-1" aria-label="ลด">−</button>
              <input type="number" name="qty" value="1" min="1" max="20" inputmode="numeric">
              <button type="button" data-step="1" aria-label="เพิ่ม">+</button>
            </div>
          </div>
        </div>

        <div class="avail-box" data-avail>เลือกวันและเวลา เพื่อตรวจสอบว่าชุดว่างหรือไม่</div>

        <div class="row" style="gap:10px">
          <% if (user) { %>
            <button class="btn" style="flex:1" data-submit>เพิ่มลงตะกร้า</button>
            <button class="btn secondary" name="next" value="product" data-submit>เพิ่ม & เลือกชุดอื่นต่อ</button>
          <% } else { %>
            <a class="btn line block" href="/login">เข้าสู่ระบบด้วย LINE เพื่อจอง</a>
          <% } %>
        </div>
        <p class="small muted" style="margin-top:10px">ระยะเวลาเช่านับเป็นชั่วโมงจากเวลาที่เริ่มเช่า (1 วัน = 24 ชม.) · ร้านใช้เวลาเตรียมชุด <%= buffers.before %> ชม. ก่อนเริ่มเช่า และตรวจสอบ/ทำความสะอาด <%= buffers.after %> ชม. หลังคืน</p>
      </form>

      <div class="card" style="margin-top:22px">
        <div class="card-title"><h3>ปฏิทินวันว่าง</h3><span class="small muted" data-cal-note></span></div>
        <div class="cal" data-calendar></div>
        <div class="cal-legend"><span class="l-free">ว่าง (เริ่มเช่าได้)</span><span class="l-full">เต็ม</span><span class="l-closed">ปิดรับจอง</span></div>
      </div>

      <div style="margin-top:22px">
        <details class="acc" open><summary>รายละเอียดสินค้า</summary><div><%= p.description || '-' %></div></details>
        <details class="acc"><summary>เงื่อนไขการเช่า</summary><div><%= p.conditions ? p.conditions + '\n\n' : '' %><%= settings.rental_terms %>

เวลารับ/เริ่มเช่าและคืนชุด: <%= String(settings.pickup_start_hour).padStart(2,'0') %>:00 – <%= String(settings.pickup_end_hour).padStart(2,'0') %>:00 น.
ต้องจองล่วงหน้าอย่างน้อย <%= settings.min_advance_hours %> ชั่วโมง</div></details>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

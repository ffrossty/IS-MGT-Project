<%- include('../partials/header') %>
<section class="hero-wrap">
<div class="container hero">
  <div class="eyebrow">Rental Collection</div>
  <h1>Dress for the <em>moment</em>,<br>not forever.</h1>
  <p>เลือกวันและเวลาที่ต้องการใช้ชุด ระบบจะแสดงเฉพาะชุดที่ว่างจริงตามสต็อกและตารางการจอง</p>

  <form id="f" method="get" action="/" class="date-panel" style="margin-top:22px">
    <div class="field">
      <label for="start_date">วันเริ่มเช่า</label>
      <div class="date-wrap"><input type="date" id="start_date" name="start_date" value="<%= rental.date %>" min="<%= T.toInputDate(Date.now()) %>"><span class="date-ph" aria-hidden="true">แตะเพื่อเลือกวันที่</span></div>
    </div>
    <div class="field">
      <label for="start_time">เวลา</label>
      <select id="start_time" name="start_time">
        <% timeOptions.forEach(t => { %><option value="<%= t %>" <%= (rental.time || timeOptions[0]) === t ? 'selected' : '' %>><%= t %> น.</option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="days">ระยะเวลาเช่า</label>
      <select id="days" name="days">
        <option value="">เลือก</option>
        <% durations.forEach(d => { %><option value="<%= d %>" <%= rental.days === d ? 'selected' : '' %>><%= d %> วัน (<%= d*24 %> ชม.)</option><% }) %>
      </select>
    </div>
    <div class="span-2">
      <% if (rentalError) { %>
        <div class="due-note" style="background:var(--bad-soft);color:#8c342b"><%= rentalError %></div>
      <% } else if (due) { %>
        <div class="due-note">เริ่ม <strong><%= T.dt(due.startAt) %></strong><br>คืนชุดภายใน <strong><%= T.dt(due.dueAt) %></strong> (<%= due.hours %> ชม.)</div>
      <% } else { %>
        <div class="due-note muted">เลือกวัน เวลา และระยะเวลา เพื่อดูชุดที่ว่างและกำหนดคืน</div>
      <% } %>
    </div>
    <div class="span-2" style="display:flex;gap:8px">
      <button class="btn" type="submit" style="flex:1">ค้นหาชุดที่ว่าง</button>
      <% if (rental.date) { %><a class="btn secondary" href="/?start_date=">ล้าง</a><% } %>
    </div>
    <% ['q','sort','show','size','bmin','bmax','wmin','wmax','hmin','hmax','lmin','lmax','bfs','wfs','hfs','lfs'].forEach(k => { if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>" data-keep="<%= k %>"><% } }) %>
  </form>
</div>
</section>
<section class="container">
  <details class="avail-note" data-open-wide>
    <summary><strong>วันว่างของชุด</strong> <span class="muted">— ชุดที่มีคนเช่าอยู่จะแสดง “ว่างประมาณ” คำนวณอย่างไร?</span></summary>
    ชุดที่มีลูกค้าเช่าอยู่จะแสดง “ว่างประมาณ” ซึ่งนับจากกำหนดคืนของลูกค้าก่อนหน้า บวกเวลาซักและตรวจสภาพชุด
    <ul>
      <li>ลูกค้าก่อนหน้าส่งคืนแบบ<strong>ส่งด่วน</strong> (Grab / Lalamove): + <%= note.express %></li>
      <li>ลูกค้าก่อนหน้าส่งคืนแบบ<strong>ส่งพัสดุ</strong> (EMS, Flash, Kerry, J&amp;T ฯลฯ): + <%= note.parcel %></li>
      <% if (note.before) { %><li>และเวลาเตรียมชุดก่อนส่งให้ลูกค้าคนถัดไป <%= note.before %></li><% } %>
    </ul>
    <span class="muted">ป้าย <strong style="color:var(--warn)">มีผู้จองแล้ว · รอยืนยันการชำระเงิน</strong> = มีลูกค้าจองช่วงนี้และร้านกำลังตรวจสอบการชำระเงิน หากไม่ได้รับการยืนยัน ชุดจะกลับมาว่างอีกครั้ง</span><br>
    <span class="muted">ตัวอย่าง: ลูกค้าคืนชุดภายใน <%= note.exampleDue %> → ส่งด่วน ว่างประมาณ <%= note.exampleExpress %> · ส่งพัสดุ ว่างประมาณ <%= note.exampleParcel %> — หากร้านเตรียมชุดเสร็จก่อน ชุดจะเปิดให้จองได้เร็วกว่าวันที่แสดง</span>
  </details>
</section>

<section class="container">
  <div class="catalog">
    <div class="filters-mobile">
      <button type="button" class="btn secondary sm filters-btn" data-toggle="#filters" style="margin-bottom:14px">ตัวกรอง ⌄</button>
      <% const MKEYS = ['size','bmin','bmax','wmin','wmax','hmin','hmax','lmin','lmax','bfs','wfs','hfs','lfs']; const anyFilter = ['q', ...MKEYS].some(k => query[k]); %>
      <aside class="filters <%= anyFilter ? 'open' : '' %>" id="filters">
        <h4>ค้นหา</h4>
        <form method="get" action="/">
          <% ['sort','show', ...MKEYS].forEach(k => { if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% } }) %>
          <input type="search" name="q" value="<%= query.q || '' %>" placeholder="ชื่อชุด">
        </form>
        <form method="get" action="/" class="measure-filter">
          <% ['q','sort','show'].forEach(k => { if (query[k]) { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% } }) %>
          <h4 style="margin-bottom:0">ไซส์</h4>
          <select name="size" aria-label="ไซส์">
            <option value="">ทุกไซส์</option>
            <% sizes.forEach(sz => { %><option value="<%= sz %>" <%= measure.size === sz ? 'selected' : '' %>><%= sz %></option><% }) %>
          </select>
          <h4 style="margin-bottom:0">สัดส่วน <span class="muted" style="font-weight:400;text-transform:none;letter-spacing:0">(นิ้ว)</span></h4>
          <% measure.fields.forEach(m => { %>
            <div class="mf-row" data-fs-wrap>
              <div class="mf-head">
                <label class="mf-label" for="f_<%= m.key %>min"><strong><%= m.ab %></strong><span><%= m.label %> · <%= m.th %></span></label>
                <label class="fs-toggle"><input type="checkbox" name="<%= m.key %>fs" value="1" data-fs <%= m.free ? 'checked' : '' %>><span>Freesize</span></label>
              </div>
              <div class="mf-range">
                <input type="number" id="f_<%= m.key %>min" name="<%= m.key %>min" value="<%= m.free ? '' : (query[m.key + 'min'] || '') %>" min="0" max="200" step="0.5" inputmode="decimal" placeholder="ตั้งแต่">
                <span class="mf-to">ถึง</span>
                <input type="number" name="<%= m.key %>max" value="<%= m.free ? '' : (query[m.key + 'max'] || '') %>" min="0" max="200" step="0.5" inputmode="decimal" placeholder="ถึง" aria-label="<%= m.label %> สูงสุด">
              </div>
            </div>
          <% }) %>
          <div class="row" style="gap:8px;margin-top:4px">
            <button class="btn sm" style="flex:1">กรอง</button>
            <% if (measure.active.length || measure.size) { %><a class="btn sm secondary" href="<%= h.qs(query, {size:'',bmin:'',bmax:'',wmin:'',wmax:'',hmin:'',hmax:'',lmin:'',lmax:'',bfs:'',wfs:'',hfs:'',lfs:''}) %>">ล้าง</a><% } %>
          </div>
          <p class="small muted" style="margin:2px 0 0">ใส่เฉพาะช่องที่ต้องการก็ได้ เช่น อก 32 ถึง 35 · ติ๊ก Freesize เพื่อดูชุดที่สัดส่วนนั้นเป็นฟรีไซส์ (ไม่ต้องใส่ช่วง)</p>
        </form>
        <h4>การแสดงผล</h4>
        <div class="chips">
          <a class="chip <%= !onlyAvailable ? 'active' : '' %>" href="<%= h.qs(query, {show: ''}) %>">ทุกชุด</a>
          <a class="chip <%= onlyAvailable ? 'active' : '' %>" href="<%= h.qs(query, {show: 'available'}) %>">เฉพาะที่ว่าง</a>
        </div>
        <% if (anyFilter) { %><p style="margin-top:16px"><a class="link small" href="/">ล้างตัวกรองทั้งหมด</a></p><% } %>
      </aside>
    </div>

    <div>
      <div class="row between" style="margin-bottom:16px">
        <div class="muted small">
          <% if (rental.startAt && rental.days && !rentalError) { %>
            <% const nFree = products.filter(p => p.availability === 'available').length; %>
            <%= products.length %> ชุด · ว่าง <strong style="color:var(--ink)"><%= nFree %></strong> ชุด สำหรับ <%= T.date(rental.startAt) %> · <%= rental.days %> วัน
          <% } else { %>
            <%= products.length %> ชุดในคอลเลกชัน<% if (measure.size) { %> · ไซส์ <%= measure.size %><% } %><% if (measure.active.length) { %> · <%= measure.active.map(m => m.ab + ' ' + (m.free ? 'Freesize' : m.min != null && m.max != null ? m.min + '–' + m.max : m.min != null ? '≥ ' + m.min : '≤ ' + m.max)).join(', ') %><% } %>
          <% } %>
        </div>
        <form method="get" action="/">
          <% Object.keys(query).filter(k => k !== 'sort').forEach(k => { %><input type="hidden" name="<%= k %>" value="<%= query[k] %>"><% }) %>
          <select name="sort" data-autosubmit style="width:auto;padding:7px 12px;font-size:.86rem">
            <option value="">ใหม่ล่าสุด</option>
            <option value="popular" <%= query.sort==='popular'?'selected':'' %>>ยอดนิยม</option>
            <option value="price_asc" <%= query.sort==='price_asc'?'selected':'' %>>ราคา: ต่ำ → สูง</option>
            <option value="price_desc" <%= query.sort==='price_desc'?'selected':'' %>>ราคา: สูง → ต่ำ</option>
          </select>
        </form>
      </div>

      <% if (!products.length) { %>
        <div class="empty">
          <h3>ไม่พบชุดที่ตรงกับเงื่อนไข</h3>
          <p>ลองเปลี่ยนวันที่ ระยะเวลา หรือขยายช่วงสัดส่วน</p>
          <% if (onlyAvailable) { %><a class="btn secondary sm" href="<%= h.qs(query, {show: ''}) %>">ดูชุดทั้งหมด</a><% } %>
        </div>
      <% } %>
      <div class="product-grid">
        <% products.forEach(p => { %>
          <a class="product-card <%= p.availability === 'unavailable' || p.availability === 'out' ? 'busy' : '' %>" href="/products/<%= p.id %>">
            <div class="img">
              <% if (p.images.length > 1) { %>
                <div class="slides" data-slides>
                  <% p.images.forEach((f, i) => { %><img src="<%= h.img(f) %>" alt="<%= p.name %><%= i ? ' (' + (i + 1) + ')' : '' %>" loading="lazy" class="<%= i === 0 ? 'is-active' : '' %>"><% }) %>
                </div>
                <div class="slide-dots" aria-hidden="true"><% p.images.forEach((f, i) => { %><span class="<%= i === 0 ? 'on' : '' %>"></span><% }) %></div>
              <% } else { %>
                <img src="<%= h.img(p.image) %>" alt="<%= p.name %>" loading="lazy">
              <% } %>
              <% if (p.availability === 'available') { %><span class="badge ok"><%= rental.startAt && rental.days && !rentalError ? 'ว่างในช่วงที่เลือก' : 'ว่าง พร้อมให้เช่า' %></span>
              <% } else if (p.availability === 'held') { %><span class="badge warn avail-badge held">มีผู้จองแล้ว<small>รอยืนยันการชำระเงิน</small></span>
              <% } else if (p.availability === 'unavailable') { %><span class="badge bad avail-badge">ไม่ว่าง<% if (p.nextAt) { %><small>ว่างประมาณ <%= T.dt(p.nextAt) %></small><% } else { %><small>สอบถามร้าน</small><% } %></span>
              <% } else { %><span class="badge muted">ยังไม่มีสต็อก</span><% } %>
            </div>
            <div class="meta">
              <div class="title"><%= p.name %></div>
              <div class="price"><% if (p.promo) { %><span class="sale"><%= baht(p.price) %></span> <s class="was"><%= baht(p.originalPrice) %></s><% } else { %><%= baht(p.price) %><% } %> <small>/ <%= p.priceDays %> วัน</small>
                <% if (p.promo) { %><span class="promo-tag">-<%= p.percentOff %>%<%= p.promo.label ? ' · ' + p.promo.label : '' %></span><% } %></div>
              <% const vs = p.variants || []; const one = vs.length === 1 ? vs[0].sku : null; const ms = one ? h.measures(one) : ''; const labels = vs.map(v => v.size).filter(Boolean); %>
              <% if (labels.length || ms) { %><div class="measures-line"><% if (labels.length) { %><span class="size-pills"><% labels.forEach(l => { %><span class="size-pill"><%= l %></span><% }) %></span><% } %><%= ms %></div><% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>

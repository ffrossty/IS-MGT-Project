<%- include('../partials/header') %>
<div class="login-wrap">
  <div class="card pad-lg login-card">
    <div class="brand" style="align-items:center"><span class="name"><%= settings.shop_name %></span><span class="tag"><%= settings.shop_tagline %></span></div>
    <hr>
    <h2 style="font-size:1.25rem">เข้าสู่ระบบเพื่อจองชุด</h2>
    <p class="muted small">ใช้บัญชี LINE ของคุณ ไม่ต้องสมัครสมาชิก ระบบจะจดจำข้อมูลและประวัติการจองให้อัตโนมัติ และแจ้งเตือนสถานะผ่าน LINE</p>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <% if (config.lineLoginConfigured) { %>
      <a href="/auth/line" class="btn line block" style="padding:14px">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2.5C6.2 2.5 1.5 6.3 1.5 11c0 4.2 3.7 7.7 8.8 8.4.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.5 6-3.5 8.2-6.1 1.5-1.6 2.3-3.3 2.3-5.2 0-4.7-4.7-8.5-10.5-8.5z"/></svg>
        เข้าสู่ระบบด้วย LINE
      </a>
    <% } else { %>
      <div class="flash warn" style="text-align:left">
        <strong>ยังไม่ได้ตั้งค่า LINE Login</strong><br>
        กรุณาใส่ <span class="mono">LINE_LOGIN_CHANNEL_ID</span> และ <span class="mono">LINE_LOGIN_CHANNEL_SECRET</span> ในไฟล์ <span class="mono">.env</span><br>
        Callback URL: <span class="mono"><%= config.baseUrl %>/auth/line/callback</span>
      </div>
    <% } %>
    <% if (config.devLogin) { %>
      <details style="margin-top:22px; text-align:left">
        <summary class="small muted" style="cursor:pointer">Dev Login (สำหรับทดสอบระบบ — ไม่ใช่ LINE Login)</summary>
        <form method="post" action="/auth/dev-login" style="margin-top:12px">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label>ชื่อที่แสดง</label><input type="text" name="name" value="ลูกค้าทดสอบ" required></div>
          <div class="field"><label>บทบาท</label><select name="role"><option value="customer">Customer</option><option value="admin">Admin</option></select></div>
          <button class="btn secondary block">เข้าสู่ระบบแบบทดสอบ</button>
          <p class="hint small muted" style="margin-top:8px">ปิดอัตโนมัติเมื่อ NODE_ENV=production · บัญชีทดสอบจะไม่ได้รับ LINE Notification</p>
        </form>
      </details>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
